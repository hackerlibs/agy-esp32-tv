{
  "agy-tv": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ../host/agy_tv.py hook",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ../host/agy_tv.py hook",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../host/agy_tv.py hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../host/agy_tv.py hook",
            "timeout": 5
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python3 ../host/agy_tv.py hook",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ../host/agy_tv.py hook",
        "timeout": 5
      }
    ]
  }
}

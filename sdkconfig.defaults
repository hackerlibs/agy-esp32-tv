# Applied on the first build (and by tools/build.sh --reconfigure). Pin settings
# with menuconfig go to sdkconfig, which is not checked in.

CONFIG_IDF_TARGET="esp32c3"

# Flash: 4 MB, driven in the same DIO @ 80 MHz mode as the stock firmware.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Console on the built-in USB Serial/JTAG: this is the port the bridge uses.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# A single factory app. No NVS, so the stock firmware's settings partition is
# left untouched and tools/restore_original.sh can put everything back.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
